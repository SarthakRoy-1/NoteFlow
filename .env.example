# Copy to .env and fill in. Never commit .env.

# --- Server ---
NODE_ENV=development
PORT=
APP_BASE_URL=
SESSION_SECRET=
SESSION_TTL_DAYS=

# --- Database (PostgreSQL) ---
# POSTGRES_PASSWORD is used by docker-compose.dev.yml to create the local dev database.
POSTGRES_PASSWORD=
DATABASE_URL=
TEST_DATABASE_URL=

# --- Google OAuth 2.0 ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- Email: verification links and password reset ---
# Leave EMAIL_PROVIDER blank to keep email sign-up and password reset switched off
# (it falls back to `resend` when only RESEND_API_KEY is set).
EMAIL_PROVIDER=
EMAIL_FROM=
# Option 1: Gmail SMTP with an App Password (no domain needed).
#   EMAIL_PROVIDER=smtp  SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_SECURE=true
#   SMTP_USER and EMAIL_FROM are your Gmail address; SMTP_PASS is a 16-character App Password.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Option 2: Resend (EMAIL_FROM must be a sender Resend has verified).
RESEND_API_KEY=

# --- AI provider ---
# AI_PROVIDER=gemini or groq. Blank = Gemini if configured, otherwise Groq if configured.
# A chosen provider that is incomplete turns AI off; it never falls back to the other one.
AI_PROVIDER=
# Groq (OpenAI-compatible API). GROQ_MODEL is optional; blank uses the default model.
GROQ_API_KEY=
GROQ_MODEL=

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
