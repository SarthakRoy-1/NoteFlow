# Copy to .env and fill in. Never commit .env.

# --- Server ---
NODE_ENV=development
PORT=
APP_BASE_URL=
SESSION_SECRET=
SESSION_TTL_DAYS=

# --- Database (PostgreSQL) ---
# POSTGRES_PASSWORD is used by docker-compose.dev.yml to create the local dev database.
POSTGRES_PASSWORD=
DATABASE_URL=
TEST_DATABASE_URL=

# --- Google OAuth 2.0 ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
