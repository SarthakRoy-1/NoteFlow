# Copy to .env and fill in. Never commit .env.

# --- Server ---
NODE_ENV=development
PORT=
APP_BASE_URL=
SESSION_SECRET=
SESSION_TTL_DAYS=
# Google sign-in: "Remember me" ticked keeps a persistent cookie for REMEMBER_ME_TTL_DAYS (default 30);
# unticked it is a browser-session cookie that the server also expires after SESSION_ONLY_TTL_HOURS (24).
REMEMBER_ME_TTL_DAYS=
SESSION_ONLY_TTL_HOURS=

# --- Database (PostgreSQL) ---
# POSTGRES_PASSWORD is used by docker-compose.dev.yml to create the local dev database.
POSTGRES_PASSWORD=
DATABASE_URL=
TEST_DATABASE_URL=

# --- Google OAuth 2.0 ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- Custom email/password sign-in ---
# The assignment requires Google OAuth and forbids a custom email/password login, so this is OFF.
# Blank or false = disabled: register, login, email verification, password reset and Google
# linking return 404 and the UI hides them. Set to true only to deliberately re-enable them.
ENABLE_PASSWORD_AUTH=false

# --- Email: verification links and password reset ---
# Leave EMAIL_PROVIDER blank to keep email sign-up and password reset switched off
# (it falls back to `resend` when only RESEND_API_KEY is set).
EMAIL_PROVIDER=
EMAIL_FROM=
# Option 1: Gmail SMTP with an App Password (no domain needed).
#   EMAIL_PROVIDER=smtp  SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_SECURE=true
#   SMTP_USER and EMAIL_FROM are your Gmail address; SMTP_PASS is a 16-character App Password.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Option 2: Resend (EMAIL_FROM must be a sender Resend has verified).
RESEND_API_KEY=

# --- AI provider ---
# AI_PROVIDER=gemini or groq. Blank = Gemini if configured, otherwise Groq if configured.
# A chosen provider that is incomplete turns AI off; it never falls back to the other one.
AI_PROVIDER=
# Groq (OpenAI-compatible API). GROQ_MODEL is optional; blank uses the default model.
GROQ_API_KEY=
GROQ_MODEL=

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Reminder notifications (email + Web Push) ---
# Email uses the EMAIL_PROVIDER / RESEND_API_KEY / EMAIL_FROM settings above; with none configured,
# reminder emails are simply not sent. For Resend, EMAIL_FROM must be an address on a domain you
# verified in Resend (the shared onboarding sender only reaches the Resend account owner).
#
# Web Push needs a VAPID key pair: run `npx web-push generate-vapid-keys` once and paste the two
# values. VAPID_SUBJECT is a contact, e.g. mailto:you@example.com. The private key stays on the
# server; the public key is handed to the browser by the API (no frontend env var needed).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Lets an external scheduler (cron-job.org, GitHub Actions, Render cron) trigger delivery with
#   POST /api/internal/notifications/dispatch   Authorization: Bearer <this value>
# Use 32+ random characters. Blank = that endpoint does not exist. This is what delivers on a
# host that sleeps when idle (Render's free plan).
NOTIFICATIONS_CRON_SECRET=
# The in-process poller (true by default). It cannot run while the host is asleep.
NOTIFICATIONS_SCHEDULER=
NOTIFICATIONS_POLL_SECONDS=
